<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meu Site</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* ============================================================
   ⚙️  PAINEL DE CORES — mude aqui pra mudar o site inteiro
   ============================================================ */
:root{
  --bg-base:       #0a1128;   /* azul escuro principal do site */
  --bg-deep:       #060a1a;   /* azul ainda mais escuro (gradiente de fundo) */
  --accent-cyan:   #3ddcff;   /* cor de destaque (logo, brilhos, links) */
  --accent-blue:   #3a86ff;
  --text-primary:  #eef2ff;
  --text-muted:    #94a3c4;
  --card-bg:       #131c3a;
  --card-border:   #243156;
  --sun-color:     #ff8a3d;   /* cor do sol / modo dia */
  --sun-glow:      #ffb347;
  --moon-color:    #0a0a12;   /* cor da lua / modo noite */
  --moon-glow:     #c9d6ff;

  --radius-lg: 22px;
  --radius-md: 14px;
  --ease: cubic-bezier(.22,1,.36,1);
}

*{ box-sizing:border-box; margin:0; padding:0; }

html{ scroll-behavior:smooth; }

body{
  font-family:'Inter', system-ui, sans-serif;
  color:var(--text-primary);
  background: radial-gradient(circle at 50% -10%, #102050 0%, var(--bg-base) 45%, var(--bg-deep) 100%);
  min-height:100vh;
  overflow-x:hidden;
  transition: background-color 1.1s var(--ease);
  position:relative;
}

/* textura sutil de grade (estética "dev") */
body::before{
  content:"";
  position:fixed; inset:0;
  background-image:
    linear-gradient(rgba(61,220,255,.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(61,220,255,.05) 1px, transparent 1px);
  background-size: 42px 42px;
  pointer-events:none;
  mask-image: radial-gradient(circle at 50% 10%, black, transparent 75%);
  z-index:0;
}

/* overlay de cor que muda com o sol/lua, por cima de tudo, atrás do conteúdo */
#themeOverlay{
  position:fixed; inset:0;
  pointer-events:none;
  z-index:1;
  background: linear-gradient(180deg, transparent 0%, transparent 100%);
  opacity:0;
  transition: opacity .6s var(--ease);
}

.wrap{ position:relative; z-index:2; max-width:980px; margin:0 auto; padding:64px 24px 40px; }

/* ============================================================
   HERO — logo + nome + texto
   ============================================================ */
.hero{ text-align:center; padding-bottom:54px; animation: fadeUp .9s var(--ease) both; }

.logo-circle{
  width:108px; height:108px; border-radius:50%;
  margin:0 auto 22px;
  background: radial-gradient(circle at 35% 30%, var(--accent-cyan), var(--accent-blue) 60%, #1c2c63 100%);
  box-shadow: 0 0 0 1px rgba(61,220,255,.25), 0 18px 50px -12px rgba(61,220,255,.55);
  display:flex; align-items:center; justify-content:center;
  font-family:'JetBrains Mono', monospace; font-weight:700; font-size:1.3rem; color:#06122c;
  animation: floatLogo 5s ease-in-out infinite;
}

@keyframes floatLogo{ 0%,100%{ transform:translateY(0)} 50%{ transform:translateY(-8px)} }

.site-name{
  font-family:'Space Grotesk', sans-serif;
  font-weight:700;
  font-size: clamp(1.9rem, 4.5vw, 2.8rem);
  letter-spacing:-.01em;
  margin-bottom:14px;
}

.eyebrow{
  font-family:'JetBrains Mono', monospace;
  font-size:.78rem; letter-spacing:.18em; text-transform:uppercase;
  color:var(--accent-cyan); display:block; margin-bottom:10px;
}

.hero-text{
  color:var(--text-muted);
  font-size:1.05rem; line-height:1.7;
  max-width:560px; margin:0 auto;
}

/* ============================================================
   CARDS — os 4 quadrados (A B C D)
   ============================================================ */
.cards-section{ padding:46px 0 64px; }

.cards-label{
  font-family:'JetBrains Mono', monospace; font-size:.78rem;
  color:var(--text-muted); text-align:center; margin-bottom:22px; letter-spacing:.08em;
}

.cards-grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:18px;
}
@media (max-width:680px){ .cards-grid{ grid-template-columns: repeat(2,1fr); } }
@media (max-width:380px){ .cards-grid{ grid-template-columns: 1fr; } }

.card{
  position:relative;
  aspect-ratio:1/1;
  border-radius:var(--radius-md);
  background:var(--card-bg);
  border:1px solid var(--card-border);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:16px;
  text-align:center;
  overflow:hidden;
  cursor:default;
  transition: transform .45s var(--ease), box-shadow .45s var(--ease), border-color .45s var(--ease);
  animation: fadeUp .8s var(--ease) both;
}
.card:nth-child(1){ animation-delay:.05s }
.card:nth-child(2){ animation-delay:.12s }
.card:nth-child(3){ animation-delay:.19s }
.card:nth-child(4){ animation-delay:.26s }

.card:hover{
  transform: translateY(-6px);
  border-color: var(--card-accent, var(--accent-cyan));
  box-shadow: 0 16px 40px -14px var(--card-accent, var(--accent-cyan));
}

.card::before{
  content:"";
  position:absolute; inset:-1px;
  background: radial-gradient(circle at 50% 0%, var(--card-accent, var(--accent-cyan)) 0%, transparent 60%);
  opacity:.12;
  pointer-events:none;
}

.card-badge{
  position:absolute; top:10px; left:12px;
  font-family:'JetBrains Mono', monospace;
  font-size:.72rem; font-weight:700;
  color:var(--card-accent, var(--accent-cyan));
  border:1px solid var(--card-accent, var(--accent-cyan));
  width:20px; height:20px; border-radius:6px;
  display:flex; align-items:center; justify-content:center;
}

.card-text{
  font-size:.98rem;
  line-height:1.4;
  color:var(--text-primary);
  word-break:break-word;
}
.card-text.is-bold{ font-weight:700; }
.card-text.is-big{ font-size:1.3rem; }

/* ============================================================
   RODAPÉ — arco + sol/lua + interruptor
   ============================================================ */
.sun-section{
  padding:30px 0 10px;
  display:flex; flex-direction:column; align-items:center; gap:26px;
}

.arc-area{
  position:relative;
  width:min(420px, 90vw);
  height:170px;
}

.arc-area svg{ position:absolute; inset:0; width:100%; height:100%; overflow:visible; }

.arc-track{
  fill:none;
  stroke: var(--card-border);
  stroke-width:2;
  stroke-linecap:round;
}

.arc-progress{
  fill:none;
  stroke: var(--accent-cyan);
  stroke-width:2;
  stroke-linecap:round;
  opacity:.65;
  transition: stroke .6s var(--ease);
}

.stop-arrow{
  position:absolute;
  top:-2px; left:50%;
  transform: translateX(-50%);
  width:0; height:0;
  border-left:7px solid transparent;
  border-right:7px solid transparent;
  border-top:10px solid var(--accent-cyan);
  opacity:.55;
  transition: opacity .35s, transform .35s, filter .35s;
}
.stop-arrow.near{
  opacity:1;
  transform: translateX(-50%) translateY(3px) scale(1.25);
  filter: drop-shadow(0 0 8px var(--sun-glow));
}

.orb{
  position:absolute;
  width:46px; height:46px;
  border-radius:50%;
  left:0; top:0;
  margin-left:-23px; margin-top:-23px;
  display:flex; align-items:center; justify-content:center;
  background: radial-gradient(circle at 35% 30%, var(--sun-glow), var(--sun-color) 70%);
  box-shadow: 0 0 28px 4px rgba(255,138,61,.55);
  cursor:grab;
  touch-action:none;
  transition: background .55s var(--ease), box-shadow .55s var(--ease);
  font-size:1.3rem;
  user-select:none;
}
.orb:active{ cursor:grabbing; }
.orb.is-disabled{ opacity:.35; cursor:not-allowed; filter:grayscale(.6); }

.orb .icon{
  animation: spin 9s linear infinite;
  pointer-events:none;
}
.orb.is-moon .icon{ animation: none; }

@keyframes spin{ from{ transform:rotate(0)} to{ transform:rotate(360deg)} }

.toggle-row{
  display:flex; align-items:center; gap:12px;
  font-family:'JetBrains Mono', monospace; font-size:.82rem; color:var(--text-muted);
}

.switch{
  --w:54px; --h:30px;
  width:var(--w); height:var(--h);
  border-radius:999px;
  background:#1b264a;
  border:1px solid var(--card-border);
  position:relative;
  cursor:pointer;
  transition: background .4s var(--ease), border-color .4s var(--ease);
  flex-shrink:0;
}
.switch::after{
  content:"";
  position:absolute; top:2px; left:2px;
  width:24px; height:24px; border-radius:50%;
  background:#cdd6f0;
  transition: transform .4s var(--ease), background .4s var(--ease);
}
.switch.on{ background:var(--accent-blue); border-color:var(--accent-cyan); }
.switch.on::after{ transform:translateX(24px); background:#fff; }

.switch-label{ min-width:34px; }

footer.tiny{
  text-align:center; color:var(--text-muted);
  font-family:'JetBrains Mono', monospace; font-size:.72rem;
  padding:36px 0 10px; opacity:.6;
}

/* ============================================================
   animações gerais
   ============================================================ */
@keyframes fadeUp{
  from{ opacity:0; transform:translateY(18px); }
  to{ opacity:1; transform:translateY(0); }
}

:focus-visible{ outline:2px solid var(--accent-cyan); outline-offset:3px; }

/* aviso de devtools bloqueado */
#devtoolsWarning{
  position:fixed; inset:0; z-index:9999;
  background:rgba(6,10,26,.96);
  backdrop-filter: blur(6px);
  display:none;
  align-items:center; justify-content:center;
  text-align:center; padding:24px;
  font-family:'JetBrains Mono', monospace;
}
#devtoolsWarning.show{ display:flex; }
#devtoolsWarning p{ max-width:420px; color:var(--text-muted); line-height:1.6; }
#devtoolsWarning strong{ color:var(--accent-cyan); display:block; font-size:1.1rem; margin-bottom:10px; }

@media (prefers-reduced-motion: reduce){
  *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; }
}
</style>
</head>
<body>

<div id="themeOverlay"></div>
<div id="devtoolsWarning"><p><strong>Ferramentas de desenvolvedor desativadas</strong>Feche o painel de inspeção para continuar navegando.</p></div>

<div class="wrap">

  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="logo-circle" id="logoCircle">LX</div>
    <h1 class="site-name" id="siteName">Nome do Site</h1>
    <span class="eyebrow">// bem-vindo</span>
    <p class="hero-text" id="heroText">
      Escreva aqui o texto de apresentação do site. Esse parágrafo, o nome
      acima e o conteúdo dos quadrados abaixo são todos editados em um único
      lugar no código — veja o bloco <code>CONFIG</code> no topo do script.
    </p>
  </header>

  <!-- ============ CARDS A B C D ============ -->
  <section class="cards-section">
    <span class="cards-label">// configurações — edite em CONFIG.cards</span>
    <div class="cards-grid" id="cardsGrid"></div>
  </section>

  <!-- ============ SOL / LUA ============ -->
  <section class="sun-section">
    <div class="arc-area" id="arcArea">
      <svg viewBox="0 0 400 200">
        <path class="arc-track" d="M 30 190 A 170 170 0 0 1 370 190"/>
        <path class="arc-progress" id="arcProgress" d="M 30 190 A 170 170 0 0 1 370 190"/>
      </svg>
      <div class="stop-arrow" id="stopArrow"></div>
      <div class="orb" id="orb" tabindex="0" role="slider" aria-label="Arraste para alternar entre sol e lua"
           aria-valuemin="0" aria-valuemax="180" aria-valuenow="90">
        <span class="icon" id="orbIcon">☀️</span>
      </div>
    </div>

    <div class="toggle-row">
      <span class="switch-label" id="switchLabel">NÃO</span>
      <div class="switch" id="powerSwitch" role="switch" aria-checked="false" tabindex="0" aria-label="Ativar modo dia/noite"></div>
      <span>ativar modo dia/noite</span>
    </div>
  </section>

  <footer class="tiny">feito com HTML · CSS · JS puro</footer>
</div>

<script>
/* ============================================================
   ⚙️  CONFIG — É SÓ MEXER AQUI PRA EDITAR O SITE
   ============================================================ */
const CONFIG = {
  logoInitials: "LX",                 // letras dentro do círculo da logo
  siteName: "Nome do Site",           // nome grande abaixo da logo
  heroText: "Escreva aqui o texto de apresentação do site. Esse parágrafo, o nome acima e o conteúdo dos quadrados abaixo são todos editados em um único lugar no código — veja o bloco CONFIG no topo do script.",

  // os 4 quadrados — mude texto, cor, e os "interruptores" de estilo
  cards: [
    { letter: "A", text: "Escreva aqui",  color: "#3ddcff", bold: false, big: false },
    { letter: "B", text: "Escreva aqui",  color: "#7c5cff", bold: false, big: false },
    { letter: "C", text: "Escreva aqui",  color: "#ff8a3d", bold: false, big: false },
    { letter: "D", text: "Escreva aqui",  color: "#3aff8c", bold: false, big: false },
  ]
};

/* ---------- aplica o CONFIG na página ---------- */
document.getElementById("logoCircle").textContent = CONFIG.logoInitials;
document.getElementById("siteName").textContent   = CONFIG.siteName;
document.getElementById("heroText").textContent   = CONFIG.heroText;

const grid = document.getElementById("cardsGrid");
CONFIG.cards.forEach(c => {
  const div = document.createElement("div");
  div.className = "card";
  div.style.setProperty("--card-accent", c.color);
  div.innerHTML = `
    <span class="card-badge">${c.letter}</span>
    <span class="card-text${c.bold ? " is-bold" : ""}${c.big ? " is-big" : ""}">${c.text}</span>
  `;
  grid.appendChild(div);
});

/* ============================================================
   ARCO SOL / LUA — arraste o sol pelo arco
   ============================================================ */
const arcArea   = document.getElementById("arcArea");
const orb       = document.getElementById("orb");
const orbIcon   = document.getElementById("orbIcon");
const arcProg   = document.getElementById("arcProgress");
const stopArrow = document.getElementById("stopArrow");
const overlay   = document.getElementById("themeOverlay");
const powerSwitch = document.getElementById("powerSwitch");
const switchLabel = document.getElementById("switchLabel");

const ARC_R = 170;      // raio do arco (mesmo valor do SVG)
const CX = 200, CY = 190; // centro do arco no viewBox 400x200

let enabled = false;       // interruptor liga/desliga a funcionalidade
let angle = 90;            // 0 = ponta esquerda (sol), 180 = ponta direita (lua), 90 = topo (parada)
let dragging = false;

function placeOrb(a){
  const rad = (180 - a) * Math.PI / 180; // 0deg na esquerda, 180deg na direita
  const x = CX + ARC_R * Math.cos(rad);
  const y = CY - ARC_R * Math.sin(rad);
  // converte coordenadas do viewBox (400x200) pra porcentagem da área
  orb.style.left = (x / 400 * 100) + "%";
  orb.style.top  = (y / 200 * 100) + "%";
}

function updateVisuals(){
  const distFromTop = Math.abs(angle - 90); // 0 = no topo (setinha), 90 = numa ponta
  const proximity = 1 - Math.min(distFromTop / 90, 1); // 1 = bem perto da seta

  // seta brilha quando o sol/lua tá perto dela
  stopArrow.classList.toggle("near", proximity > 0.55 && enabled);

  if (!enabled){
    overlay.style.opacity = 0;
    orb.classList.remove("is-moon");
    orbIcon.textContent = "☀️";
    arcProg.style.stroke = "#3ddcff";
    return;
  }

  const isMoonSide = angle > 90;
  orb.classList.toggle("is-moon", isMoonSide);
  orbIcon.textContent = isMoonSide ? "🌙" : "☀️";

  // intensidade de cor cresce conforme se afasta do topo (da seta) em direção à ponta
  const intensity = Math.min(distFromTop / 90, 1);

  if (isMoonSide){
    overlay.style.background = `linear-gradient(180deg, rgba(5,5,10,${0.85*intensity}) 0%, rgba(5,5,10,${0.55*intensity}) 60%, transparent 100%)`;
    arcProg.style.stroke = "#c9d6ff";
  } else {
    overlay.style.background = `linear-gradient(180deg, rgba(255,138,61,${0.55*intensity}) 0%, rgba(255,138,61,${0.32*intensity}) 60%, transparent 100%)`;
    arcProg.style.stroke = "#ff8a3d";
  }
  overlay.style.opacity = intensity;

  orb.style.boxShadow = isMoonSide
    ? `0 0 ${20+24*intensity}px ${4+4*intensity}px rgba(201,214,255,${0.35+0.3*intensity})`
    : `0 0 ${20+24*intensity}px ${4+4*intensity}px rgba(255,138,61,${0.35+0.3*intensity})`;

  orb.setAttribute("aria-valuenow", Math.round(angle));
}

function angleFromPointer(clientX, clientY){
  const rect = arcArea.getBoundingClientRect();
  const px = clientX - rect.left;
  const py = clientY - rect.top;
  // posição relativa ao centro do arco (centro fica embaixo, no meio)
  const cx = rect.width / 2;
  const cy = rect.height; // CY fica praticamente na base da área
  let a = Math.atan2(cy - py, px - cx) * 180 / Math.PI; // 0 = direita, 180 = esquerda
  a = 180 - a; // inverte pra 0 = esquerda (sol), 180 = direita (lua)
  return Math.max(0, Math.min(180, a));
}

function startDrag(e){
  if (!enabled){ pulseDisabled(); return; }
  dragging = true;
  orb.style.transition = "none";
  e.preventDefault();
}
function moveDrag(clientX, clientY){
  if (!dragging) return;
  angle = angleFromPointer(clientX, clientY);
  placeOrb(angle);
  updateVisuals();
}
function endDrag(){
  if (!dragging) return;
  dragging = false;
  orb.style.transition = "background .55s var(--ease), box-shadow .55s var(--ease)";
}

function pulseDisabled(){
  orb.animate(
    [{ transform:"scale(1)" }, { transform:"scale(.88)" }, { transform:"scale(1)" }],
    { duration:280, easing:"ease-out" }
  );
}

orb.addEventListener("pointerdown", startDrag);
window.addEventListener("pointermove", (e) => moveDrag(e.clientX, e.clientY));
window.addEventListener("pointerup", endDrag);

// teclado: setas movem o sol/lua (acessibilidade)
orb.addEventListener("keydown", (e) => {
  if (!enabled) return;
  if (e.key === "ArrowLeft"){ angle = Math.max(0, angle-5); placeOrb(angle); updateVisuals(); }
  if (e.key === "ArrowRight"){ angle = Math.min(180, angle+5); placeOrb(angle); updateVisuals(); }
});

/* ---------- interruptor liga/desliga ---------- */
function setEnabled(v){
  enabled = v;
  powerSwitch.classList.toggle("on", v);
  powerSwitch.setAttribute("aria-checked", String(v));
  switchLabel.textContent = v ? "SIM" : "NÃO";
  orb.classList.toggle("is-disabled", !v);
  if (!v){
    angle = 90;
    placeOrb(angle);
  }
  updateVisuals();
}
powerSwitch.addEventListener("click", () => setEnabled(!enabled));
powerSwitch.addEventListener("keydown", (e) => {
  if (e.key === "Enter" || e.key === " "){ e.preventDefault(); setEnabled(!enabled); }
});

// posição inicial
placeOrb(angle);
updateVisuals();
window.addEventListener("resize", () => placeOrb(angle));

/* ============================================================
   BLOQUEIO BÁSICO DE F12 / INSPECIONAR
   (impede o acesso casual; não é uma proteção 100% à prova de tudo)
   ============================================================ */
document.addEventListener("contextmenu", e => e.preventDefault());

document.addEventListener("keydown", e => {
  const k = e.key;
  if (
    k === "F12" ||
    (e.ctrlKey && e.shiftKey && ["I","J","C","i","j","c"].includes(k)) ||
    (e.ctrlKey && ["U","u","S","s"].includes(k)) ||
    (e.metaKey && e.altKey && ["I","i","J","j"].includes(k))
  ){
    e.preventDefault();
  }
});

const devtoolsBox = document.getElementById("devtoolsWarning");
setInterval(() => {
  const widthGap  = window.outerWidth  - window.innerWidth  > 170;
  const heightGap = window.outerHeight - window.innerHeight > 170;
  devtoolsBox.classList.toggle("show", widthGap || heightGap);
}, 600);
</script>
</body>
</html>
